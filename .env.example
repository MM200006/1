# SerpAPI key for Google Maps search
# Get yours at: https://serpapi.com/
SERPAPI_KEY=your_serpapi_key_here

# Anthropic API key for AI analysis
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Path to Google Service Account JSON credentials for Google Sheets
# See README.md for setup instructions
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json

# Google Spreadsheet ID (from the URL of your spreadsheet)
# e.g. https://docs.google.com/spreadsheets/d/THIS_PART_IS_THE_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here
